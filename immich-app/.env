# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=./postgres

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
 TZ=Asia/Kolkata

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
IMMICH_VERSION=v2

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=YTk3NjFhND

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Microsoft OAuth
OAUTH_ENABLED=true
OAUTH_CLIENT_ID=efdb91c0-0d93-4c0c-ad25-d80ece4efebf
OAUTH_CLIENT_SECRET=ba4365d8-ebf5-458b-a21d-7627d39fae98
OAUTH_TENANT_ID=8787cfc8-4e14-4cb5-9d27-f2190626a332
OAUTH_REDIRECT_URI=http://localhost:2283/api/auth/microsoft/redirect
OAUTH_SCOPE=openid profile email
OAUTH_ISSUER_URL=https://login.microsoftonline.com/8787cfc8-4e14-4cb5-9d27-f2190626a332/v2.0

# OneDrive integration — uses the same Microsoft app registration above.
# Make sure your Azure app has "Files.ReadWrite.All offline_access" scopes added,
# and redirect URI: http://localhost:2283/api/cloud-storage/callback/onedrive
IMMICH_ONEDRIVE_CLIENT_ID=efdb91c0-0d93-4c0c-ad25-d80ece4efebf
IMMICH_ONEDRIVE_CLIENT_SECRET=ba4365d8-ebf5-458b-a21d-7627d39fae98
# Use your tenant ID to restrict to your org, or set to 'common' for personal + work accounts
IMMICH_ONEDRIVE_TENANT=8787cfc8-4e14-4cb5-9d27-f2190626a332

